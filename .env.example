# Copie para .env e preencha. O .env está no .gitignore e NUNCA deve ser commitado.

# --- Login do site (usado pelos scripts npm run import / backup) ---
APP_EMAIL=
APP_PASSWORD=

# --- Supabase (Settings -> API). URL e anon são públicas; ficam também em assets/config.js ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Só se for usar a Supabase CLI (deploy de Edge Function). Crie em supabase.com/dashboard/account/tokens ---
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# --- Só para religar a IA da Rota Internacional (console.anthropic.com, NÃO é a claude.ai).
# Não vai no front-end: é enviada ao Supabase com `supabase secrets set --env-file .env`.
ANTHROPIC_API_KEY=

# --- Opcional: só se for automatizar push/criação do repo (o `git push` normal usa seu login do Git) ---
GITHUB_TOKEN=
